cabal-version:   3.0
name:            agdalicious-lsp
version:         0.1.0.0
synopsis:        Language server for Agda with an infoview protocol
license:         MIT
build-type:      Simple

common shared
  default-language: GHC2021
  ghc-options:      -Wall
  default-extensions:
    DataKinds
    LambdaCase
    OverloadedStrings

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules:
    Agdalicious.Agda
    Agdalicious.Client
    Agdalicious.Completion
    Agdalicious.Document
    Agdalicious.Foreign
    Agdalicious.Hover
    Agdalicious.Infoview
    Agdalicious.Libraries
    Agdalicious.Manual
    Agdalicious.Server
    Agdalicious.Shadow
    Agdalicious.Source
  build-depends:
    , aeson      >=2.0
    , async
    , base       >=4.18 && <5
    , bytestring
    , containers
    , directory
    , file-embed
    , filepath
    , lens
    , lens-aeson
    , lsp        >=2.7 && <2.8
    , lsp-types  >=2.3 && <2.4
    , mtl
    , process
    , text
    , text-rope
    , transformers
    , unliftio-core

executable agdalicious-lsp
  import:         shared
  hs-source-dirs: app
  main-is:        Main.hs
  other-modules:
    Paths_agdalicious_lsp
    Version
    Version.Commit
  autogen-modules: Paths_agdalicious_lsp
  ghc-options:    -threaded -rtsopts
  build-depends:
    , agdalicious-lsp
    , base
    , directory
    , optparse-applicative
    , process
    , template-haskell
