cabal-version:   3.0
name:            agdalicious-lsp
version:         0.1.0.0
synopsis:        Language server for Agda with an infoview protocol
license:         MIT
build-type:      Simple

common shared
  default-language: GHC2021
  ghc-options:      -Wall
  default-extensions:
    DataKinds
    LambdaCase
    OverloadedStrings

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules:
    Agdalicous.Infoview
    Agdalicous.Server
  build-depends:
    , aeson      >=2.0
    , base       >=4.18 && <5
    , lens
    , lsp        >=2.7 && <2.8
    , lsp-types  >=2.3 && <2.4
    , text

executable agdalicious-lsp
  import:         shared
  hs-source-dirs: app
  main-is:        Main.hs
  ghc-options:    -threaded -rtsopts
  build-depends:
    , agdalicious-lsp
    , base
